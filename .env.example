PORT=5000

ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=

# Local:
# ZOHO_REDIRECT_URI=http://localhost:5000/api/zoho/callback
# Render (must also be added in Zoho Server-based client):
# ZOHO_REDIRECT_URI=https://YOUR-SERVICE.onrender.com/api/zoho/callback
ZOHO_REDIRECT_URI=http://localhost:5000/api/zoho/callback

# org = instance-level ORG client (/oauth/v2/org/auth)
# server = Server-based Applications (/oauth/v2/auth) — required for multi-user Connect
ZOHO_OAUTH_MODE=server

# India example:
# ZOHO_ACCOUNTS_URL=https://accounts.zoho.in
# ZOHO_API_DOMAIN=https://mail.zoho.in
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
ZOHO_API_DOMAIN=https://mail.zoho.com

ZOHO_ACCESS_TOKEN=
ZOHO_REFRESH_TOKEN=

# Required for regular org admins (from Mail Admin Console → Organization → Profile)
ZOHO_ZOID=

ZOHO_SCOPES=ZohoMail.organization.accounts.ALL,ZohoMail.accounts.ALL,ZohoMail.folders.ALL,ZohoMail.messages.ALL

ZOHO_CONCURRENCY=2
ZOHO_REQUEST_TIMEOUT_MS=30000

# Supabase / Postgres (required on Render — admin + mailbox tokens live here)
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
