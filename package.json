    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.23",
    "@types/node": "^22.17.1",
    "@types/pg": "^8.23.1",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2"
  }
